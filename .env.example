# ---------------------------------------------------------------------------
# Agent Runtime â€” example configuration.
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# --- Model provider -------------------------------------------------------
# One of: anthropic | openai | local | scripted
# "scripted" is a deterministic offline provider used by the tests and the
# demo script. It needs no API key and no network, so a fresh clone runs
# end to end before you add any credentials.
MODEL_PROVIDER=scripted
MODEL_NAME=

# Only the key for the selected provider is required. Startup fails loudly
# if the selected provider needs a key that is missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local / OpenAI-compatible endpoint (llama.cpp, Ollama, vLLM, ...) -----
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_API_KEY=not-needed
LOCAL_MODEL_NAME=qwen3:8b

# --- Privileged intent parser ---------------------------------------------
# The privileged domain never calls a cloud model. It uses either a local
# endpoint or the deterministic rule-based parser.
# One of: rules | local
PRIVILEGED_PARSER=rules
PRIVILEGED_MODEL_BASE_URL=http://127.0.0.1:8080/v1
PRIVILEGED_MODEL_API_KEY=not-needed
PRIVILEGED_MODEL_NAME=local-model

# --- Storage ---------------------------------------------------------------
# Separate databases: the app process must not be able to write privileged
# state, so in a real deployment these live on different filesystems with
# different owners.
DATABASE_PATH=./data/runtime.db
PRIVILEGED_DATABASE_PATH=./data/privileged.db

# --- Workspace -------------------------------------------------------------
# Filesystem tools are confined to this directory. Path traversal out of it
# is rejected by the tool, not by the agent.
WORKSPACE_ROOT=./workspace

# --- API authentication ----------------------------------------------------
# Comma-separated "name:role:token" triples for the normal API.
# Roles: operator (create tasks) | viewer (read only).
# Development default below; replace it before exposing the API.
API_TOKENS=dev:operator:dev-token

# --- Privileged approval ---------------------------------------------------
# Second, independent authority. Format: "operator_id:scrypt_hash".
# Generate a hash with:  python -m privileged.cli hash-secret
# Empty means no operator can approve anything (safe default).
PRIVILEGED_OPERATORS=
# HTTP approval endpoints are OFF by default. Approval is CLI-only unless you
# explicitly turn this on and understand the exposure.
PRIVILEGED_API_ENABLED=false
PRIVILEGED_APPROVAL_TTL_SECONDS=900

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO

# --- Control center and role defaults --------------------------------------
# Saved profiles override model environment defaults; keep outside WORKSPACE_ROOT.
MODEL_PROFILES_PATH=./data/models.json
PROJECT_NAME=default
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT_SECONDS=120
MODEL_RETRY_COUNT=2
SUPERVISOR_MAX_STEPS=4
RESEARCHER_MAX_STEPS=10
CODER_MAX_STEPS=16
REVIEWER_MAX_STEPS=10
# Optional per-role overrides (all four roles support these suffixes):
# CODER_PROVIDER=local
# CODER_MODEL=qwen3-coder:30b
# CODER_MAX_TOKENS=8192
# Never expose development prompt inspection beyond loopback.
DEV_PROMPT_INSPECTION=false

# Public internet tools fail closed unless explicitly enabled.
INTERNET_ACCESS_ENABLED=false
